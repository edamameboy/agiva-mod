{
  "name": "tiktok-live-bridge",
  "version": "1.5.0",
  "description": "TikTok Live bridge server for game mods",
  "main": "src/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/edamameboy/agiva-mod.git"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "start:app": "electron .",
    "build:app": "electron-builder --windows",
    "build:nsis": "electron-builder --windows nsis",
    "build:portable": "electron-builder --windows portable",
    "build:all": "electron-builder --windows"
  },
  "build": {
    "appId": "com.junkyardmod.app",
    "productName": "junkyard-mod-agiva",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "public/**/*",
      "!public/media/**/*",
      "games/**/*",
      "data/**/*",
      "!data/sessions/**/*",
      "!data/actions-config.json",
      "!data/points-db.json",
      "!data/chatbot-config.json",
      "!data/intervals-config.json",
      "effects-config.json",
      "gifts-data.json",
      ".env.example",
      "package.json",
      "!**/*.map",
      "!**/*.pdb"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-${version}-setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  },
  "dependencies": {
    "@eulerstream/euler-websocket-sdk": "^1.0.0",
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "tiktok-live-api-sdk": "^0.5.2",
    "tiktok-live-connector": "^2.4.4",
    "ws": "^8.14.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3"
  }
}
