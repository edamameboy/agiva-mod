{
  "name": "tiktok-live-bridge",
  "version": "1.2.1",
  "description": "TikTok Live bridge server for game mods",
  "main": "src/main.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "start:app": "electron .",
    "build:app": "electron-builder --windows"
  },
  "build": {
    "appId": "com.junkyardmod.app",
    "productName": "junkyard-mod-agiva",
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "@eulerstream/euler-websocket-sdk": "^1.0.0",
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "tiktok-live-api-sdk": "^0.5.2",
    "tiktok-live-connector": "^2.4.4",
    "ws": "^8.14.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3"
  }
}
