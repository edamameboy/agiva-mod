# ============================================================
# Agiva Mod - TikTok Live Bridge Configuration
# ============================================================

# Eulerstream API Key (Dapatkan di: https://eulerstream.com)
EULERSTREAM_API_KEY=

# TikTok username default (bisa diubah dari dashboard)
TIKTOK_USERNAME=

# Port untuk web dashboard & API (default: 7030)
DASHBOARD_PORT=7030

# Port untuk WebSocket ke game mod (default: 7827)
MOD_WS_PORT=7827

# Path ke folder game (untuk auto-detect BepInEx plugin)
GAME_PATH=

# Webhook URL eksternal (opsional)
WEBHOOK_URL=

# Webhook secret (opsional, untuk validasi signature HMAC)
WEBHOOK_SECRET=

# TikTok Session ID cookie (opsional / otomatis terisi jika login via Electron)
TIKTOK_SESSION_ID=
